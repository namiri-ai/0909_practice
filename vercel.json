{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "destination": "https://namiri-3.vercel.app/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "<https://namiri-3.vercel.app/>; rel=\"canonical\"" }
      ]
    }
  ]
}
